    "outputEurPerMillionTokens": 14.0,
    "outputTokensPerCall": 120,
    "charsPerToken": 4
  },
  "reranker": {
    "C": 1.0
  },
  "glossary": [
    {
      "pattern": "umgebungstemp|ambient",
